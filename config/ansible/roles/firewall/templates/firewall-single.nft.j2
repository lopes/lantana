# /etc/lantana/honeywall/nftables/firewall.nft
# Managed by Ansible

# --- BASE NAT TABLES ---
table ip lantana_nat {
    chain prerouting {
        type nat hook prerouting priority -100; policy accept;
        # Plugins hook here for DNAT
    }
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;

        # SNAT/Masquerade egressing sensor traffic
        ip saddr $SENSOR_NETS_V4 oifname $WAN_IF masquerade
    }
}

table ip6 lantana_nat6 {
    chain prerouting {
        type nat hook prerouting priority -100; policy accept;
    }
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        ip6 saddr $SENSOR_NETS_V6 oifname $WAN_IF masquerade
    }
}

# --- FILTER TABLE ---
table inet lantana_filter {
    set allowed_egress_tcp_ports {
        type inet_service
        elements = { 53, 80, 443 }
    }

    set allowed_egress_udp_ports {
        type inet_service
        elements = { 53, 67, 123, 547 }
    }

    set drop_log_v4 {
        type ipv4_addr
        size 65535
        flags dynamic,timeout
        timeout 5m
    }

    set drop_log_v6 {
        type ipv6_addr
        size 65535
        flags dynamic,timeout
        timeout 5m
    }

    chain input {
        type filter hook input priority 0; policy drop;

        # 1. CORE SAFETY & STATE
        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop

        # 2. ANTI-EVASION
        iifname $SENSOR_IF icmpv6 type nd-router-advert drop

        # 3. MANAGEMENT & INFRASTRUCTURE
        tcp dport {{ ansible_port }} accept

        # Allow Collector traffic using the global variables
        iifname $SENSOR_IF ip saddr $COLLECTOR_IPS_V4 tcp dport {{ network.collectors.collector_01.port }} accept
        iifname $SENSOR_IF ip6 saddr $COLLECTOR_IPS_V6 tcp dport {{ network.collectors.collector_01.port }} accept

        # 4. ICMP/v6 - rate limited
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, echo-request, echo-reply } limit rate 10/second burst 20 packets accept
        ip protocol icmp icmp type echo-request limit rate 10/second burst 20 packets accept
        ip protocol icmp icmp type { destination-unreachable, time-exceeded } accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        # 1. CORE STATE
        ct state established,related accept
        ct state invalid drop

        # 2. STRICT EGRESS INTELLIGENCE
        iifname $SENSOR_IF oifname $WAN_IF ct state new limit rate 10/minute burst 5 packets log prefix "[LANTANA_FORWARD_DROP_EGRESS] " level info
        iifname $SENSOR_IF oifname $WAN_IF ct state new drop
    }

    chain output {
        type filter hook output priority 0; policy drop;

        # 1. ESTABLISHED/RELATED REPLIES (inbound honeypot responses pass here)
        ct state established,related accept
        ct state invalid drop

        # 2. SENSOR-USER CONTAINMENT (100% dark runtime egress for stigma/pasta)
        # Blocks WAN (53/80/443/UDP/ICMP), loopback (127.0.0.1:8501 Vigil,
        # 127.0.0.53:53 systemd-resolved DNS bypass), and ltn0 collector pivots.
        # Unconditional match (established,related + invalid handled above) prevents
        # untracked packets from falling through; `counter drop` counts 100% of drops.
        oifname "lo" meta skuid {{ system.users.sensor.uid }} limit rate 10/minute burst 5 packets log prefix "[LANTANA_OUTPUT_DROP_SENSOR_LO] " level info
        oifname "lo" meta skuid {{ system.users.sensor.uid }} counter drop
        oifname $SENSOR_IF meta skuid {{ system.users.sensor.uid }} limit rate 10/minute burst 5 packets log prefix "[LANTANA_OUTPUT_DROP_SENSOR_LO] " level info
        oifname $SENSOR_IF meta skuid {{ system.users.sensor.uid }} counter drop

        meta skuid {{ system.users.sensor.uid }} limit rate 10/minute burst 5 packets log prefix "[LANTANA_OUTPUT_DROP_SENSOR_WAN] " level info
        meta skuid {{ system.users.sensor.uid }} counter drop

        # 3. CORE HOST TRAFFIC (non-stigma users: root, nectar, vector, suricata)
        oifname "lo" accept

        # 4. MAINTENANCE
        udp dport @allowed_egress_udp_ports accept
        tcp dport @allowed_egress_tcp_ports accept

        # 5. ICMP
        ip protocol icmp accept
        meta l4proto icmpv6 accept

        # 6. LOG DROPS
        limit rate 5/minute log prefix "[LANTANA_OUTPUT_DROP] " level info
    }
}

# --- LOAD PLUGINS ---
include "/etc/lantana/honeywall/nftables/sensors/*.nft"

# --- TRAILING RULES: TSHOOT LOGGING & DROP ---
table inet lantana_filter {
    chain input {
        # Per-source rate limit (2/min burst 3) + global safety cap (5/sec burst 10)
        # Prevents high-rate scanners from blinding dark-space telemetry while avoiding syslog DoS.
        meta nfproto ipv4 add @drop_log_v4 { ip saddr limit rate 2/minute burst 3 packets } limit rate 5/second burst 10 packets log prefix "[LANTANA_INPUT_DROP] " level info
        meta nfproto ipv6 add @drop_log_v6 { ip6 saddr limit rate 2/minute burst 3 packets } limit rate 5/second burst 10 packets log prefix "[LANTANA_INPUT_DROP] " level info
    }
    chain forward {
        limit rate 10/minute burst 5 packets log prefix "[LANTANA_FORWARD_DROP] " level info
    }
}
