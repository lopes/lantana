# /etc/lantana/logrotate.d/00_00/firewall
# Managed by Ansible

/var/log/lantana/honeywall/nftables/firewall.log
/var/log/lantana/honeywall/nftables/sensor-egress.log
{
    # Forced at 00:00 UTC + hourly maxsize safety pass
    maxsize 100M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    create 0644 root root
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}
