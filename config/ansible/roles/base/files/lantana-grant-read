#!/bin/sh
# Grant collector user (nectar) read/write/traverse POSIX ACLs on sensor scratch
# directories without altering stigma ownership or mode bits. Enforces strict
# sensor-root allowlisting, walks every path component with O_NOFOLLOW + dir_fd,
# caps depth, and passes pinned /proc/self/fd/<fd> handles to setfacl so a
# compromised sensor user can never redirect root ACL grants onto arbitrary
# host paths via symlinks or TOCTOU.
# Deployed by ansible role base.
set -eu

if [ $# -eq 0 ]; then
  echo "Usage: $0 <path> [<path>...]" >&2
  exit 1
fi

exec /usr/bin/python3 - "$@" <<'PY'
import contextlib
import os
import posixpath
import stat
import subprocess
import sys

ALLOWED_PREFIX = "/var/lib/lantana/sensor/"
ACL_SPEC = "u:nectar:rwX"
MAX_DEPTH = 32
BATCH_SIZE = 32


def _apply_setfacl(fds: list[int], *, default: bool = False) -> None:
    if not fds:
        return
    cmd = ["setfacl"]
    if default:
        cmd.append("-d")
    cmd.extend(["-m", ACL_SPEC, "--"])
    cmd.extend(f"/proc/self/fd/{fd}" for fd in fds)
    subprocess.run(cmd, pass_fds=tuple(fds), check=True)


def _open_chain_nofollow(raw_path: str) -> int:
    if not raw_path.startswith("/") or ".." in raw_path.split("/"):
        raise ValueError(f"Rejected unsafe path: {raw_path}")
    norm = posixpath.normpath(raw_path)
    if not norm.startswith(ALLOWED_PREFIX):
        raise ValueError(f"Path outside {ALLOWED_PREFIX}: {raw_path}")

    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    parts = [p for p in norm.split("/") if p]
    cur_fd = os.open("/", flags)
    for part in parts:
        try:
            next_fd = os.open(part, flags, dir_fd=cur_fd)
        except OSError:
            os.close(cur_fd)
            raise
        os.close(cur_fd)
        cur_fd = next_fd
    return cur_fd


def _grant_tree(root_fd: int) -> None:
    _apply_setfacl([root_fd], default=False)
    _apply_setfacl([root_fd], default=True)

    dir_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    file_flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    stack: list[tuple[int, int, bool]] = [(root_fd, 0, False)]

    try:
        while stack:
            cur_fd, depth, owns_fd = stack.pop()
            file_batch: list[int] = []
            try:
                entries = list(os.scandir(cur_fd))
                for entry in entries:
                    try:
                        st = os.stat(entry.name, dir_fd=cur_fd, follow_symlinks=False)
                    except OSError:
                        continue
                    mode = st.st_mode
                    if stat.S_ISLNK(mode):
                        continue
                    if stat.S_ISDIR(mode):
                        if depth >= MAX_DEPTH:
                            continue
                        try:
                            child_fd = os.open(entry.name, dir_flags, dir_fd=cur_fd)
                        except OSError:
                            continue
                        try:
                            _apply_setfacl([child_fd], default=False)
                            _apply_setfacl([child_fd], default=True)
                        except Exception:
                            os.close(child_fd)
                            raise
                        stack.append((child_fd, depth + 1, True))
                    elif stat.S_ISREG(mode):
                        try:
                            ffd = os.open(entry.name, file_flags, dir_fd=cur_fd)
                        except OSError:
                            continue
                        try:
                            fst = os.fstat(ffd)
                            if not stat.S_ISREG(fst.st_mode):
                                os.close(ffd)
                                continue
                        except OSError:
                            os.close(ffd)
                            continue
                        file_batch.append(ffd)
                        if len(file_batch) >= BATCH_SIZE:
                            try:
                                _apply_setfacl(file_batch, default=False)
                            finally:
                                for open_fd in file_batch:
                                    os.close(open_fd)
                                file_batch.clear()
                if file_batch:
                    try:
                        _apply_setfacl(file_batch, default=False)
                    finally:
                        for open_fd in file_batch:
                            os.close(open_fd)
                        file_batch.clear()
            finally:
                for open_fd in file_batch:
                    with contextlib.suppress(OSError):
                        os.close(open_fd)
                if owns_fd:
                    with contextlib.suppress(OSError):
                        os.close(cur_fd)
    finally:
        for fd, _depth, owns_fd in stack:
            if owns_fd:
                with contextlib.suppress(OSError):
                    os.close(fd)


for target in sys.argv[1:]:
    fd = _open_chain_nofollow(target)
    try:
        _grant_tree(fd)
    finally:
        os.close(fd)
PY
