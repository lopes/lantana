#!/bin/sh
# Grant collector user (nectar) read/write/traverse POSIX ACLs on sensor scratch
# directories without altering owner, group, or rootless subuid permissions
# (e.g. Dionaea worker UID 100999). Uses -P (--physical) so symlinks inside
# sensor trees are never followed. Deployed by ansible role base.
set -eu

if [ $# -eq 0 ]; then
  echo "Usage: $0 <path> [<path>...]" >&2
  exit 1
fi

for path in "$@"; do
  if [ ! -d "$path" ]; then
    echo "Not a directory: $path" >&2
    exit 1
  fi
  setfacl -R -P -m u:nectar:rwX -- "$path"
  setfacl -d -m u:nectar:rwX -- "$path"
done
