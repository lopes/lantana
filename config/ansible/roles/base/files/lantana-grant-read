#!/bin/sh
# Recursively grant group-read/traverse permission to nectar on directory trees
# while stripping world permissions. Used by per-honeypot crons to expose
# rootless-container files (which default to 0600) to the lantana pipeline user
# (nectar) without exposing them world-readable. Deployed by ansible role base.
set -eu

if [ $# -eq 0 ]; then
  echo "Usage: $0 <path> [<path>...]" >&2
  exit 1
fi

for path in "$@"; do
  if [ ! -d "$path" ]; then
    echo "Not a directory: $path" >&2
    exit 1
  fi
  chgrp -R nectar -- "$path" && chmod -R g+rX,o-rwx -- "$path"
done
