# /etc/vector/conf.d/dionaea.yaml
# Managed by Ansible

sources:
  in_dionaea:
    type: file
    include:
      - /var/log/lantana/sensor/dionaea/dionaea.json
    read_from: end

transforms:
  tag_dionaea:
    type: remap
    inputs:
      - in_dionaea
    source: |-
      parsed, err = parse_json(.message)
      if err == null {
          . = parsed
      }

      # Flatten nested connection object to top-level fields
      if exists(.connection) {
          .connection_protocol = del(.connection.protocol)
          .connection_transport = del(.connection.transport)
          .connection_type = del(.connection.type)
          del(.connection)
      }

      # Flatten credentials array (take first entry)
      if exists(.credentials) && is_array(.credentials) && length!(.credentials) > 0 {
          .credential_username = .credentials[0].username
          .credential_password = .credentials[0].password
      }
      del(.credentials)

      # Flatten FTP commands (join into single string)
      if exists(.ftp) && exists(.ftp.commands) && is_array(.ftp.commands) && length!(.ftp.commands) > 0 {
          .ftp_command = (to_string(.ftp.commands[0].command) ?? "") + " " + (to_string(.ftp.commands[0].arguments) ?? "")
      }
      del(.ftp)

      # Normalize rich lantana_json fields when present so bronze schema stays
      # flat across HTTP probes, MSSQL/MySQL queries, and attributed binaries.
      if exists(.http_method) { .http_method = to_string(.http_method) ?? null }
      if exists(.http_uri) { .http_uri = to_string(.http_uri) ?? null }
      if exists(.http_user_agent) { .http_user_agent = to_string(.http_user_agent) ?? null }
      if exists(.http_host) { .http_host = to_string(.http_host) ?? null }
      if exists(.http_content_type) { .http_content_type = to_string(.http_content_type) ?? null }
      if exists(.http_body_preview) { .http_body_preview = to_string(.http_body_preview) ?? null }
      if exists(.sql_command) { .sql_command = to_string(.sql_command) ?? null }
      if exists(.shasum) { .shasum = to_string(.shasum) ?? null }
      if exists(.download_url) { .download_url = to_string(.download_url) ?? null }
      if exists(.binary_file_name) { .binary_file_name = to_string(.binary_file_name) ?? null }
      if exists(.eventid) { .eventid = to_string(.eventid) ?? null }

      .dataset = "dionaea"
      .server = "{{ inventory_hostname }}"
      .operation = "{{ narrative.operation_name }}"

  filter_dionaea:
    type: filter
    inputs:
      - tag_dionaea
    condition:
      type: vrl
      source: |-
        src = replace(downcase(to_string(.src_ip) ?? ""), r'^::ffff:', "")
        connection_type = to_string(.connection_type) ?? ""
        connection_type == "accept" && src != "" && !(ip_cidr_contains("127.0.0.0/8", src) ?? false) && !(ip_cidr_contains("::1/128", src) ?? false) && !(ip_cidr_contains("10.0.0.0/8", src) ?? false) && !(ip_cidr_contains("172.16.0.0/12", src) ?? false) && !(ip_cidr_contains("192.168.0.0/16", src) ?? false) && !(ip_cidr_contains("169.254.0.0/16", src) ?? false) && !(ip_cidr_contains("fe80::/10", src) ?? false) && !(ip_cidr_contains("fc00::/7", src) ?? false) && !(ip_cidr_contains("{{ network.prefixes.ipv4 }}", src) ?? false) && !(ip_cidr_contains("{{ network.prefixes.ipv6 }}", src) ?? false) && !(ip_cidr_contains("{{ network.honeywall.wan.ipv4.split('/')[0] }}/32", src) ?? false) && !(ip_cidr_contains("{{ network.honeywall.wan.ipv6.split('/')[0] }}/128", src) ?? false)
