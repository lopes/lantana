# /etc/containers/systemd/users/{{ system.users.sensor.uid }}/dionaea.container
# Managed by Ansible.
#
# PublishPort lines are generated from dionaea_service_catalog. All
# services are always published — disabling a specific protocol is a
# manual on-server operation. See docs/honeypots.md.

[Unit]
Description=Dionaea Malware Honeypot Sensor
After=network-online.target
StartLimitIntervalSec=0

[Container]
# Self-owned pinned Dionaea image (containers/dionaea/Containerfile):
# bakes dionaea.cfg (processors=filter_emu, disabling bistreams), patches
# http.py for structured HTTP telemetry, ships the lantana_json ihandler, runs
# strictly non-root as USER 1000:1000, and uses a non-destructive entrypoint
# that preserves host POSIX ACLs.
Image={{ dionaea_image }}
ContainerName=sensor-dionaea
Network=pasta

# Map the rootless host user (stigma) to the image's dionaea user (UID 1000) so
# stigma-owned bind-mount paths appear inside the container as dionaea-owned.
# UID 1000:1000 is pinned as a repo constant in containers/dionaea/Containerfile.
UserNS=keep-id:uid=1000,gid=1000

{% for svc, s in dionaea_service_catalog.items() -%}
PublishPort={{ network.sensors.sensor_01.ipv4.split('/')[0] }}:{{ s.pub_port }}:{{ s.int_port }}
PublishPort=[{{ network.sensors.sensor_01.ipv6.split('/')[0] }}]:{{ s.pub_port }}:{{ s.int_port }}
{% if s.transport == 'tcp_udp' -%}
PublishPort={{ network.sensors.sensor_01.ipv4.split('/')[0] }}:{{ s.pub_port }}:{{ s.int_port }}/udp
PublishPort=[{{ network.sensors.sensor_01.ipv6.split('/')[0] }}]:{{ s.pub_port }}:{{ s.int_port }}/udp
{% endif -%}
{% endfor %}

# Hardening
# Runs strictly as unprivileged UID 1000:1000 with zero Linux capabilities.
# Allowing unprivileged binds inside the container's isolated network namespace
# lets dionaea listen on ports 21, 80, 135, 445 without NET_BIND_SERVICE or
# root-to-dionaea privilege-drop syscalls (SETUID/SETGID/CHOWN).
DropCapability=ALL
Sysctl=net.ipv4.ip_unprivileged_port_start=0
NoNewPrivileges=true
ReadOnly=true
VolatileTmp=true

# Health check (Podman 5.x Quadlet key names)
# Application-layer handshake probe (HTTP GET -> HTTP/1., fallback FTP 220):
# catches deadlocked libev loops behind rootless pasta where pgrep and bare TCP
# connect stay green. HealthOnFailure=kill forces systemd auto-recovery.
HealthCmd=CMD python3 /healthcheck.py
HealthInterval=60s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill

# Resource limits (higher than Cowrie: handles more protocols + stores malware)
PodmanArgs=--cpus=1.0 --memory=512m

# Volumes
#   services-enabled/ and ihandlers-enabled/ are mounted :ro over the
#   baked /opt/dionaea/etc/dionaea/ directories. The baked dionaea.cfg globs
#   *.yaml from these paths, loading only our rendered services + lantana_json
#   and store ihandlers.
#   Ownership flows via UserNS=keep-id:uid=1000,gid=1000 above (no ,U needed),
#   and entrypoint.sh preserves host POSIX ACLs for vector and nectar.
Volume=/etc/lantana/sensor/dionaea/healthcheck.py:/healthcheck.py:ro
Volume=/etc/lantana/sensor/dionaea/services-enabled:/opt/dionaea/etc/dionaea/services-enabled:ro
Volume=/etc/lantana/sensor/dionaea/ihandlers-enabled:/opt/dionaea/etc/dionaea/ihandlers-enabled:ro
Volume=/var/log/lantana/sensor/dionaea:/opt/dionaea/var/log/dionaea:rw
Volume=/var/lib/lantana/sensor/dionaea:/opt/dionaea/var/lib/dionaea:rw

[Service]
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
