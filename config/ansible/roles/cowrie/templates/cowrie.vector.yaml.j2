# /etc/vector/conf.d/cowrie.yaml
# Managed by Ansible

sources:
  in_cowrie:
    type: file
    include:
      - /var/log/lantana/sensor/cowrie/cowrie.json
    read_from: end

transforms:
  tag_cowrie:
    type: remap
    inputs:
      - in_cowrie
    source: |-
      parsed, err = parse_json(.message)
      if err == null {
          . = parsed
      }
      .dataset = "cowrie"
      .server = "{{ inventory_hostname }}"
      .operation = "{{ narrative.operation_name }}"

  filter_cowrie:
    type: filter
    inputs:
      - tag_cowrie
    condition:
      type: vrl
      source: |-
        src = replace(downcase(to_string(.src_ip) ?? ""), r'^::ffff:', "")
        src != "" && !(ip_cidr_contains("127.0.0.0/8", src) ?? false) && !(ip_cidr_contains("::1/128", src) ?? false) && !(ip_cidr_contains("10.0.0.0/8", src) ?? false) && !(ip_cidr_contains("172.16.0.0/12", src) ?? false) && !(ip_cidr_contains("192.168.0.0/16", src) ?? false) && !(ip_cidr_contains("169.254.0.0/16", src) ?? false) && !(ip_cidr_contains("fe80::/10", src) ?? false) && !(ip_cidr_contains("fc00::/7", src) ?? false) && !(ip_cidr_contains("{{ network.prefixes.ipv4 }}", src) ?? false) && !(ip_cidr_contains("{{ network.prefixes.ipv6 }}", src) ?? false) && !(ip_cidr_contains("{{ network.honeywall.wan.ipv4.split('/')[0] }}/32", src) ?? false) && !(ip_cidr_contains("{{ network.honeywall.wan.ipv6.split('/')[0] }}/128", src) ?? false)
