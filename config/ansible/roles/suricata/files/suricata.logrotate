# /etc/lantana/logrotate.d/00_00/suricata
# Managed by Ansible

/var/log/lantana/honeywall/suricata/*.log
/var/log/lantana/honeywall/suricata/*.json
{
    su suricata suricata
    # Forced at 00:00 UTC + hourly maxsize safety pass
    maxsize 100M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
