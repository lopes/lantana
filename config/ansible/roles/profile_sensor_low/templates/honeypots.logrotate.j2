# /etc/lantana/logrotate.d/00_00/honeypots
# Managed by Ansible

# All low-interaction honeypots like Cowrie, Dionaea, Honeyd
/var/log/lantana/sensor/*/*.log
/var/log/lantana/sensor/*/*.json
{
    # No 'daily': forced with cron for more determinism
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
    # Restart rootless sensor Quadlets after copytruncate so writers reopen
    # fresh file descriptors at offset 0 (preventing sparse-null holes in both
    # cowrie.json and dionaea.json). Log failures to syslog rather than hiding them.
    postrotate
        for svc in {{ (sensor_honeypots | default(['cowrie', 'dionaea'])) | join(' ') }}; do
            if ! runuser -u {{ system.users.sensor.name }} -- \
                env XDG_RUNTIME_DIR=/run/user/{{ system.users.sensor.uid }} \
                systemctl --user restart "${svc}.service" 2>/dev/null; then
                logger -t lantana-logrotate -p daemon.err "Failed to restart ${svc}.service after log rotation"
            fi
        done
    endscript
}
