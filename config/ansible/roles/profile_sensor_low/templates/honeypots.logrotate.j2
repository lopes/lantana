# /etc/lantana/logrotate.d/00_00/honeypots
# Managed by Ansible
# Explicit per-sensor log paths (avoiding root-owned wildcard globs over
# container-writable directories). Both Cowrie and Dionaea map their worker UID
# to stigma via UserNS=keep-id, so both stanzas rotate under `su stigma stigma`.

/var/log/lantana/sensor/cowrie/cowrie.log
/var/log/lantana/sensor/cowrie/cowrie.json
{
    su {{ system.users.sensor.name }} {{ system.users.sensor.name }}
    # Forced at 00:00 UTC + hourly maxsize safety pass
    maxsize 100M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
    postrotate
        if ! runuser -u {{ system.users.sensor.name }} -- \
            env XDG_RUNTIME_DIR=/run/user/{{ system.users.sensor.uid }} \
            systemctl --user restart cowrie.service 2>/dev/null; then
            logger -t lantana-logrotate -p daemon.err "Failed to restart cowrie.service after log rotation"
        fi
    endscript
}

/var/log/lantana/sensor/dionaea/dionaea.log
/var/log/lantana/sensor/dionaea/dionaea-errors.log
/var/log/lantana/sensor/dionaea/dionaea.json
{
    su {{ system.users.sensor.name }} {{ system.users.sensor.name }}
    # Forced at 00:00 UTC + hourly maxsize safety pass
    maxsize 100M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
    postrotate
        if ! runuser -u {{ system.users.sensor.name }} -- \
            env XDG_RUNTIME_DIR=/run/user/{{ system.users.sensor.uid }} \
            systemctl --user restart dionaea.service 2>/dev/null; then
            logger -t lantana-logrotate -p daemon.err "Failed to restart dionaea.service after log rotation"
        fi
    endscript
}
